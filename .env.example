# -----------------------------------------------------------------------------
# Clínica Horizonte - Configuración de Variables de Entorno (.env.example)
# -----------------------------------------------------------------------------
# Nota de Seguridad: Copiar este archivo a .env y reemplazar contraseñas y claves
# con secretos generados criptográficamente. NUNCA subir .env al repositorio.

# Modo de Entorno
NODE_ENV=development

# Base de Datos PostgreSQL
POSTGRES_DB=clinica_horizonte
POSTGRES_USER=clinica_admin
POSTGRES_PASSWORD=ClinicaHorizonteSecurePass2026!
POSTGRES_PORT=5432

# URLs de Conexión a Base de Datos
# Para contenedores Docker:
DATABASE_URL=postgresql://clinica_admin:ClinicaHorizonteSecurePass2026!@database:5432/clinica_horizonte?schema=public
# Para desarrollo local fuera de Docker:
DATABASE_URL_LOCAL=postgresql://clinica_admin:ClinicaHorizonteSecurePass2026!@localhost:5432/clinica_horizonte?schema=public

# Configuración del Backend (NestJS)
BACKEND_PORT=3000
PORT=3000
SWAGGER_ENABLED=true
CORS_ORIGIN=http://localhost:4321

# Seguridad y Autenticación
JWT_SECRET=clinica-horizonte-ultra-secure-jwt-secret-key-32-chars-minimum
JWT_EXPIRATION=8h

# Configuración del Frontend (Astro SSR)
FRONTEND_PORT=4321
API_URL=http://backend:3000
PUBLIC_API_URL=http://localhost:3000

# Retención y Auditoría
AUDIT_LOG_LEVEL=info
