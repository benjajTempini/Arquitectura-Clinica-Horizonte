# =============================================================================
#  CLÍNICA HORIZONTE — Variables de Entorno y Configuración de Seguridad
# =============================================================================
# NOTA DE SEGURIDAD:
# Este archivo es una plantilla (.env.example). Para su uso, cópialo a .env:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# NUNCA subas el archivo .env a Git ni compartas contraseñas reales de producción.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_DB=clinica_horizonte
POSTGRES_USER=clinica_admin
POSTGRES_PASSWORD=ClinicaHorizonteSecurePass2026!
POSTGRES_PORT=5432

# URL de conexión para Prisma ORM:
# - Si ejecutas con Docker Compose: usa el host 'database':
#   DATABASE_URL=postgresql://clinica_admin:ClinicaHorizonteSecurePass2026!@database:5432/clinica_horizonte?schema=public
# - Si ejecutas de forma LOCAL directa (sin Docker): usa 'localhost':
DATABASE_URL=postgresql://clinica_admin:ClinicaHorizonteSecurePass2026!@localhost:5432/clinica_horizonte?schema=public

# -----------------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN Y TOKENS JWT
# -----------------------------------------------------------------------------
# Secreto para firmar tokens JWT (debe tener mínimo 32 caracteres criptográficos)
JWT_SECRET=clinica-horizonte-ultra-secure-jwt-secret-key-32-chars-minimum
# Tiempo de expiración del token JWT (8 horas para un turno laboral clínico completo)
JWT_EXPIRATION=8h
# Algoritmo de hash de contraseñas: bcrypt (salt rounds = 10)

# -----------------------------------------------------------------------------
# 4. CUENTAS DE USUARIO Y CREDENCIALES PRECONFIGURADAS (SEED SINTÉTICO)
# -----------------------------------------------------------------------------
# Contraseña universal de desarrollo para todas las cuentas de prueba:
#   Clinica2026!
#
# Cuentas generadas automáticamente al ejecutar el sembrado (seed.ts):
# ┌──────────────────────────────────────┬───────────────┬────────────────────────┐
# │ Correo                               │ Contraseña    │ Rol Asignado           │
# ├──────────────────────────────────────┼───────────────┼────────────────────────┤
# │ admin@clinicahorizonte.cl            │ Clinica2026!  │ ADMIN                  │
# │ recepcion@clinicahorizonte.cl        │ Clinica2026!  │ RECEPTIONIST           │
# │ dr.morales@clinicahorizonte.cl       │ Clinica2026!  │ DOCTOR (Med. General)  │
# │ dra.valenzuela@clinicahorizonte.cl   │ Clinica2026!  │ DOCTOR (Pediatría)     │
# │ soporte.ext@clinicahorizonte.cl      │ Clinica2026!  │ EXTERNAL_SUPPORT       │
# └──────────────────────────────────────┴───────────────┴────────────────────────┘

# -----------------------------------------------------------------------------
# 5. CONFIGURACIÓN DEL BACKEND (NestJS API REST)
# -----------------------------------------------------------------------------
BACKEND_PORT=3000
PORT=3000
SWAGGER_ENABLED=true

# Política CORS:
# - En producción con Nginx SSL: https://clinica-horizonte.tudominio.com
# - En desarrollo local: http://localhost:4321 o *
CORS_ORIGIN=https://clinica-horizonte.tudominio.com

# Ejecutar automáticamente migraciones de Prisma y sembrado al iniciar
SEED_ON_STARTUP=true

# -----------------------------------------------------------------------------
# 6. CONFIGURACIÓN DEL FRONTEND (Astro SSR + React)
# -----------------------------------------------------------------------------
FRONTEND_PORT=4321
# URL para llamadas internas servidor a servidor (SSR dentro de Docker):
API_URL=http://backend:3000

# URL pública consumida desde el navegador del cliente:
# - En producción con Nginx SSL: https://api-clinica-horizonte.tudominio.com
# - En desarrollo local: http://localhost:3000
PUBLIC_API_URL=https://api-clinica-horizonte.tudominio.com

# -----------------------------------------------------------------------------
# 7. AUDITORÍA Y REGISTROS
# -----------------------------------------------------------------------------
AUDIT_LOG_LEVEL=info
