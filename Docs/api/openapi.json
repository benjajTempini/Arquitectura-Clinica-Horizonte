    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Servicio operando con normalidad"
          }
        },
        "summary": "Comprobar salud y disponibilidad del backend y base de datos",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Clínica Horizonte API",
    "description": "API REST para la plataforma Clínica Horizonte: autenticación RBAC, pacientes, agenda, disponibilidad médica, atenciones clínicas, pagos y auditoría.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Comprobación de salud y disponibilidad"
    },
    {
      "name": "auth",
      "description": "Autenticación y control de accesos"
    },
    {
      "name": "patients",
      "description": "Gestión de pacientes"
    },
    {
      "name": "professionals",
      "description": "Profesionales de la salud y disponibilidad"
    },
    {
      "name": "specialties",
      "description": "Catálogo de especialidades médicas"
    },
    {
      "name": "appointments",
      "description": "Agenda y citas médicas"
    },
    {
      "name": "payments",
      "description": "Registro de pagos y bonos"
    },
    {
      "name": "clinical-care",
      "description": "Ficha y atenciones clínicas"
    },
    {
      "name": "audit",
      "description": "Auditoría inmutable de eventos sensibles"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Ingrese el token JWT obtenido en /api/v1/auth/login"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@clinicahorizonte.cl",
            "description": "Correo electrónico corporativo"
          },
          "password": {
            "type": "string",
            "example": "Clinica2026!",
            "description": "Contraseña del usuario"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "b819f71c-43f1-4db8-b593-3d0cf3a9486c"
          },
          "email": {
            "type": "string",
            "example": "admin@clinicahorizonte.cl"
          },
          "firstName": {
            "type": "string",
            "example": "Administrador"
          },
          "lastName": {
            "type": "string",
            "example": "Sistema"
          },
          "roles": {
            "example": [
              "ADMIN"
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "roles"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "JWT Access Token"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 28800,
            "description": "Expiración en segundos"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "CreatePatientDto": {
        "type": "object",
        "properties": {
          "nationalId": {
            "type": "string",
            "example": "15420312-K",
            "description": "RUT o documento oficial sin puntos con guion"
          },
          "firstName": {
            "type": "string",
            "example": "Carlos Alberto"
          },
          "lastName": {
            "type": "string",
            "example": "Mendoza Peña"
          },
          "birthDate": {
            "type": "string",
            "example": "1982-04-15",
            "description": "Fecha de nacimiento YYYY-MM-DD"
          },
          "gender": {
            "type": "string",
            "example": "MASCULINO",
            "enum": [
              "MASCULINO",
              "FEMENINO",
              "OTRO"
            ]
          },
          "phone": {
            "type": "string",
            "example": "+56 9 8765 4321"
          },
          "email": {
            "type": "string",
            "example": "carlos.mendoza@ejemplo.cl"
          },
          "address": {
            "type": "string",
            "example": "Av. Providencia 1240, Dpto 502"
          },
          "emergencyContact": {
            "type": "string",
            "example": "Patricia Peña (Madre) +56 9 1111 2222"
          }
        },
        "required": [
          "nationalId",
          "firstName",
          "lastName",
          "birthDate",
          "gender",
          "phone",
          "email"
        ]
      },
      "UpdatePatientDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+56 9 8765 4321"
          },
          "email": {
            "type": "string",
            "example": "nuevo.correo@ejemplo.cl"
          },
          "address": {
            "type": "string",
            "example": "Nueva Dirección 456"
          },
          "emergencyContact": {
            "type": "string",
            "example": "Contacto actualizado +56 9 9999 8888"
          }
        }
      },
      "CreateAppointmentDto": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "example": "b1234567-89ab-cdef-0123-456789abcdef",
            "description": "UUID del paciente"
          },
          "professionalId": {
            "type": "string",
            "example": "c1234567-89ab-cdef-0123-456789abcdef",
            "description": "UUID del profesional"
          },
          "specialtyId": {
            "type": "string",
            "example": "d1234567-89ab-cdef-0123-456789abcdef",
            "description": "UUID de la especialidad"
          },
          "startTime": {
            "type": "string",
            "example": "2026-09-28T09:00:00.000Z",
            "description": "Fecha y hora de inicio ISO 8601"
          },
          "endTime": {
