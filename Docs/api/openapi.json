        "tags": [
          "payments"
        ]
      }
    },
    "/api/v1/appointments/{appointmentId}/clinical-care": {
      "post": {
        "operationId": "ClinicalCareController_create_v1",
        "parameters": [
          {
            "name": "appointmentId",
            "required": true,
            "in": "path",
            "description": "UUID de la cita médica",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
