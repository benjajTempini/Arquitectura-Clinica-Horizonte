    "/api/v1/appointments": {
      "post": {
        "operationId": "AppointmentsController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointmentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cita creada exitosamente"
          },
          "409": {
            "description": "Conflicto por horario ocupado (APPOINTMENT_OVERLAP)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crear una cita médica validando no solapamiento",
        "tags": [
          "appointments"
        ]
      },
      "get": {
        "operationId": "AppointmentsController_findAll_v1",
        "parameters": [
          {
            "name": "date",
            "required": false,
            "in": "query",
            "description": "Filtrar por fecha específica YYYY-MM-DD",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "professionalId",
            "required": false,
            "in": "query",
            "description": "UUID del profesional",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "patientId",
            "required": false,
            "in": "query",
            "description": "UUID del paciente",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "CONFIRMED",
                "ARRIVED",
                "IN_CONSULTATION",
                "COMPLETED",
                "CANCELLED",
                "NO_SHOW"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de citas"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Consultar agenda de citas con filtros",
        "tags": [
          "appointments"
        ]
      }
    },
