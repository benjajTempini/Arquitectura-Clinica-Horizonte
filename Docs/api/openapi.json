              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historial clínico cronológico"
          },
          "404": {
            "description": "Paciente no encontrado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Consultar el historial clínico cronológico autorizado del paciente",
        "tags": [
          "clinical-care"
        ]
      }
