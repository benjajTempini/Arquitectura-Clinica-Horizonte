---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio — Centro de Salud Ambulatoria">
  <div class="relative overflow-hidden pt-4 pb-16 space-y-16">
    {/* Fondo con resplandor ambiental sutil */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-sky-200/30 dark:bg-teal-500/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
    <div class="absolute top-1/3 right-10 w-[400px] h-[250px] bg-blue-100/40 dark:bg-[#76eec6]/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

    {/* Banner Dinámico para Funcionarios con Sesión Activa */}
    <div id="staff-active-banner" class="hidden max-w-6xl mx-auto p-3.5 rounded-2xl bg-sky-50 dark:bg-teal-950/60 border border-sky-200 dark:border-teal-800 text-sky-800 dark:text-teal-200 text-xs flex flex-col sm:flex-row items-center justify-between gap-3 shadow-xs animate-fadeIn">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-teal-400 animate-pulse"></span>
        <span>Has iniciado sesión como <strong id="staff-name-display" class="text-slate-900 dark:text-white">Funcionario</strong> (<span id="staff-role-display" class="font-mono text-blue-700 dark:text-teal-300">Personal</span>).</span>
      </div>
      <a
        href="/dashboard"
        class="px-4 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 dark:bg-teal-600 dark:hover:bg-teal-500 text-white font-semibold transition text-xs shrink-0 flex items-center gap-1.5 shadow-xs"
      >
        <span>Ingresar a Mi Panel</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    {/* SECCIÓN HERO (ORIENTADA A PACIENTES Y ATENCIÓN AMBULATORIA) */}
    <div class="text-center max-w-6xl mx-auto space-y-6 pt-4">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white dark:bg-[#0c221e] border border-sky-200 dark:border-teal-700/60 text-sky-700 dark:text-teal-300 text-xs font-medium shadow-xs">
        <span class="w-2 h-2 rounded-full bg-sky-500 dark:bg-teal-400 animate-pulse"></span>
        <span>Centro de Salud Ambulatoria de Alta Complejidad</span>
        <span class="text-slate-300 dark:text-slate-600">|</span>
        <span class="text-slate-500 dark:text-slate-400 font-mono">Santiago, Chile</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        Atención médica de excelencia con <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-sky-600 to-blue-700 dark:from-teal-300 dark:via-[#76eec6] dark:to-teal-400">
          tecnología de vanguardia y calidez
        </span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Plataforma integral diseñada para la atención ambulatoria coordinada de más de 180 pacientes al día.
        Agendamiento sin solapamientos, consultas puntuales, convenios directos con Fonasa e Isapres y estricta confidencialidad médica.
      </p>

      {/* Botones de Acción para Pacientes */}
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/reservar-hora"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition shadow-md shadow-blue-600/20"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Reservar Hora Médica
        </a>

        <a
          href="/consultar-cita"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white dark:bg-[#0c221e] hover:bg-sky-50 dark:hover:bg-[#122e29] text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-teal-800/80 hover:border-sky-300 dark:hover:border-teal-500 font-semibold text-sm transition shadow-xs"
        >
          <svg class="w-4 h-4 text-blue-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Consultar Mi Cita (RUT)
        </a>

        <a
          href="#convenios"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-sky-50 dark:bg-teal-950/60 hover:bg-sky-100 dark:hover:bg-teal-900/60 text-sky-700 dark:text-teal-300 border border-sky-200 dark:border-teal-800 font-semibold text-sm transition shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Convenios & Copagos
        </a>
      </div>
    </div>

    {/* INDICADORES CLAVE DE SERVICIO ASISTENCIAL */}
    <div class="max-w-[1650px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white border border-sky-100 text-center shadow-xs">
        <div class="text-3xl font-extrabold text-blue-600 font-mono">180+</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">Pacientes diarios</div>
        <p class="text-[11px] text-slate-500 mt-0.5">Capacidad asistencial coordinada</p>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-sky-100 text-center shadow-xs">
        <div class="text-3xl font-extrabold text-emerald-600 font-mono">0%</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">Solapamiento de Horas</div>
        <p class="text-[11px] text-slate-500 mt-0.5">Atención puntual en box</p>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-sky-100 text-center shadow-xs">
        <div class="text-3xl font-extrabold text-sky-600 font-mono">4</div>
        <div class="text-xs text-slate-700 font-semibold mt-1">Especialidades Activas</div>
        <p class="text-[11px] text-slate-500 mt-0.5">Medicina, Pediatría, Cardio, Traumatología</p>
      </div>

      <div class="p-5 rounded-2xl bg-white border border-sky-100 text-center shadow-xs">
        <div class="text-3xl font-extrabold text-slate-900 font-mono">I-Med</div>
        <div class="text-xs text-blue-600 font-semibold mt-1">Bono Electrónico en Caja</div>
        <p class="text-[11px] text-slate-500 mt-0.5">Fonasa y todas las Isapres</p>
      </div>
    </div>

    {/* ACCESOS DIRECTOS A PORTALES DEDICADOS DEL PACIENTE */}
    <div class="max-w-[1650px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* Tarjeta 1: Reservar Hora */}
      <div class="p-8 rounded-3xl bg-gradient-to-br from-white via-sky-50/40 to-blue-50/30 border border-sky-100 hover:border-sky-300 transition flex flex-col justify-between space-y-6 shadow-sm hover:shadow-md">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-sky-100 text-blue-600 flex items-center justify-center shadow-xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xs font-mono font-semibold text-blue-600 uppercase tracking-wider block">
            Portal de Agendamiento
          </span>
          <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
            Reserva de Horas Médicas Online
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Agenda tu atención médica en 4 simples pasos. Disponibilidad en tiempo real para Medicina General, Pediatría, Cardiología y Traumatología sin solapamiento de turnos.
          </p>
        </div>

        <div class="pt-2">
          <a
            href="/reservar-hora"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm transition shadow-sm"
          >
            <span>Ir a Reservar Hora Online</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      {/* Tarjeta 2: Consultar Cita */}
      <div class="p-8 rounded-3xl bg-gradient-to-br from-white via-sky-50/40 to-slate-50 border border-sky-100 hover:border-sky-300 transition flex flex-col justify-between space-y-6 shadow-sm hover:shadow-md">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center shadow-xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <span class="text-xs font-mono font-semibold text-sky-700 uppercase tracking-wider block">
            Seguimiento de Pacientes
          </span>
          <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
            Consulta de Cita Médica Agendada
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            ¿Ya tienes una hora reservada en nuestra clínica? Ingresa tu RUT para consultar la fecha exacta, horario, facultativo asignado, box de atención e indicaciones previas.
          </p>
        </div>

        <div class="pt-2">
          <a
            href="/consultar-cita"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-sky-50 text-blue-700 font-semibold text-xs sm:text-sm border border-sky-200 transition shadow-xs"
          >
            <span>Consultar Estado con mi RUT</span>
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* SECCIÓN 2: ESPECIALIDADES MÉDICAS */}
    <div id="especialidades" class="scroll-mt-24 max-w-[1650px] mx-auto space-y-6">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider font-mono">Cuidado Clínico</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">Nuestras Especialidades Médicas</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Facultativos acreditados ante la Superintendencia de Salud con bloques de atención dedicados para cada paciente.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-white border border-sky-100 hover:border-sky-300 transition space-y-3 flex flex-col justify-between shadow-xs">
          <div>
            <div className="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-600 font-semibold">MED-GEN • 20 min</span>
              <span class="text-[11px] text-slate-500">Box 01</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 mt-1">Medicina General</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Atención primaria para adultos, manejo de patologías comunes, chequeos de salud preventivos y orden de exámenes.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 flex justify-between">
            <span>Médico:</span>
            <span class="text-slate-800 font-medium">Dr. Roberto Morales</span>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-sky-100 hover:border-sky-300 transition space-y-3 flex flex-col justify-between shadow-xs">
          <div>
            <div className="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-600 font-semibold">PED-01 • 30 min</span>
              <span class="text-[11px] text-slate-500">Box 03</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 mt-1">Pediatría Integral</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Control de niño sano, seguimiento de curvas de crecimiento, vacunatorio y tratamiento de cuadros agudos infantiles.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 flex justify-between">
            <span>Médico:</span>
            <span class="text-slate-800 font-medium">Dra. Carolina Valenzuela</span>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-sky-100 hover:border-sky-300 transition space-y-3 flex flex-col justify-between shadow-xs">
          <div>
            <div className="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-600 font-semibold">CAR-01 • 30 min</span>
              <span class="text-[11px] text-slate-500">Box 02</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 mt-1">Cardiología Preventiva</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Evaluación cardiovascular integral, monitoreo de presión arterial, prevención de infarto y electrocardiografía basal.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 flex justify-between">
            <span>Médico:</span>
            <span class="text-slate-800 font-medium">Dr. Roberto Morales</span>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-sky-100 hover:border-sky-300 transition space-y-3 flex flex-col justify-between shadow-xs">
          <div>
            <div className="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-600 font-semibold">TRA-01 • 20 min</span>
              <span class="text-[11px] text-slate-500">Box 04</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 mt-1">Traumatología</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Manejo de lesiones deportivas, esguinces, fracturas de baja energía, dolores articulares e inmovilizaciones transitorias.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 flex justify-between">
            <span>Médico:</span>
            <span class="text-slate-800 font-medium">Dr. Matías Albornoz</span>
          </div>
        </div>
      </div>
    </div>

    {/* SECCIÓN 3: CONVENIOS FONASA E ISAPRES */}
    <div id="convenios" class="scroll-mt-24 max-w-[1650px] mx-auto p-8 rounded-3xl bg-white border border-sky-100 space-y-8 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider font-mono">Coberturas de Salud</span>
          <h2 class="text-2xl font-bold text-slate-900 mt-1">Convenios con Fonasa e Isapres</h2>
          <p class="text-xs text-slate-500 mt-1">
            Atención con emisión inmediata de bono electrónico por huella dactilar I-Med en el mesón de recepción.
          </p>
        </div>
        <a href="/reservar-hora" class="text-xs text-blue-600 font-semibold hover:underline flex items-center gap-1">
          <span>Reservar con mi previsión</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-sky-50/50 border border-sky-100 space-y-3">
          <div class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-sm">
            F
          </div>
          <h4 class="font-bold text-slate-900 text-sm">Fonasa (Tramos A, B, C y D)</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Convenio Modalidad Libre Elección (MLE) Nivel 1 y 2. Tramo A con gratuidad en red pública y copago preferencial en tramos B, C y D.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-blue-50/40 border border-blue-100 space-y-3">
          <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm">
            I
          </div>
          <h4 class="font-bold text-slate-900 text-sm">Isapres con Bono I-Med</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Emisión directa con Banmédica, Colmena Golden Cross, Consalud, CruzBlanca, Nueva Masvida y Vida Tres solo con su cédula de identidad.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-emerald-50/40 border border-emerald-100 space-y-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">
            $
          </div>
          <h4 class="font-bold text-slate-900 text-sm">Pacientes Particulares</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Aranceles transparentes y fijados por resolución. Emisión de boleta médica electrónica para reembolso posterior en seguros complementarios.
          </p>
        </div>
      </div>
    </div>

    {/* SECCIÓN 4: UBICACIÓN Y CONTACTO */}
    <div id="contacto" class="scroll-mt-24 max-w-[1650px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 p-8 rounded-3xl bg-white border border-sky-100 shadow-sm">
      <div class="space-y-4">
        <div>
          <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider font-mono">Nuestra Ubicación</span>
          <h3 class="text-xl font-bold text-slate-900 mt-1">Av. Providencia 1420, Santiago</h3>
          <p class="text-xs text-slate-500 mt-1">
            A pasos del Metro Manuel Montt (Línea 1). Edificio de salud ambulatoria con acceso universal y estacionamientos convenidos.
          </p>
        </div>

        <div class="space-y-2 text-xs text-slate-600">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="font-mono text-slate-800 font-medium">Mesa Central: +56 2 2840 9200</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="font-mono text-slate-800 font-medium">contacto@clinicahorizonte.cl</span>
          </div>
        </div>
      </div>

      <div class="space-y-4 md:border-l md:border-slate-100 md:pl-6">
        <div>
          <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider font-mono">Horarios de Consulta</span>
          <h3 class="text-xl font-bold text-slate-900 mt-1">Lunes a Sábado</h3>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between text-slate-600 py-1 border-b border-slate-100">
            <span>Lunes a Viernes:</span>
            <span class="font-mono text-slate-900 font-medium">08:00 a 20:00 hrs</span>
          </div>
          <div class="flex justify-between text-slate-600 py-1 border-b border-slate-100">
            <span>Sábados:</span>
            <span class="font-mono text-slate-900 font-medium">08:30 a 14:00 hrs</span>
          </div>
          <div class="flex justify-between text-slate-500 py-1">
            <span>Domingos y Feriados:</span>
            <span class="text-amber-600 font-medium">Cerrado (Solo Urgencias Hospitalarias)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Script para detectar sesión activa de funcionario en la homepage */}
  <script is:inline>
    (function () {
      try {
        const stored = localStorage.getItem('user');
        if (stored) {
          const user = JSON.parse(stored);
          const banner = document.getElementById('staff-active-banner');
          const nameSpan = document.getElementById('staff-name-display');
          const roleSpan = document.getElementById('staff-role-display');

          if (banner && user) {
            if (nameSpan) nameSpan.textContent = (user.firstName || '') + ' ' + (user.lastName || '');
            if (roleSpan) roleSpan.textContent = (user.roles && user.roles[0]) ? user.roles[0] : 'Personal';
            banner.classList.remove('hidden');
          }
        }
      } catch (e) {
        // Silencioso
      }
    })();
  </script>
</Layout>
