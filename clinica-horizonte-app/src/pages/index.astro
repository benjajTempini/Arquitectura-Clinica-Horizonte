---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio — Plataforma de Gestión">
  <div className="py-12 sm:py-16 text-center max-w-4xl mx-auto space-y-8">
    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-400 text-xs font-semibold">
      <span className="w-2 h-2 rounded-full bg-teal-400"></span>
      Nueva Plataforma Tecnológica de Salud Ambulatoria
    </div>

    <h1 className="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight">
      Gestión Clínica y Operacional <br />
      <span className="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-teal-300 to-emerald-400">
        Clínica Horizonte
      </span>
    </h1>

    <p className="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Plataforma moderna diseñada para la atención ambulatoria de más de 180 pacientes al día.
      Centraliza agendamiento médico sin solapamientos, historia clínica segura, convenios Fonasa/Isapre y trazabilidad integral.
    </p>

    <div className="flex flex-wrap items-center justify-center gap-4 pt-4">
      <a
        href="/login"
        className="px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-sm transition shadow-xl shadow-teal-900/40"
      >
        Ingresar al Sistema
      </a>
      <a
        href="/agenda"
        className="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold text-sm transition"
      >
        Ver Agenda y Disponibilidad
      </a>
      <a
        href="http://localhost:3000/api/docs"
        target="_blank"
        rel="noreferrer"
        className="px-6 py-3 rounded-xl bg-slate-900/60 hover:bg-slate-800 text-teal-400 border border-teal-500/30 font-semibold text-sm transition"
      >
        API Docs (OpenAPI 3.x)
      </a>
    </div>

    {/* Características Principales */}
    <div className="grid grid-cols-1 md:grid-cols-3 gap-6 pt-16 text-left">
      <div className="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
        <div className="w-10 h-10 rounded-lg bg-teal-500/10 text-teal-400 flex items-center justify-center font-bold">
          01
        </div>
        <h3 className="font-bold text-white text-base">Cero Solapamientos</h3>
        <p className="text-xs text-slate-400 leading-relaxed">
          Motor de asignación de horas con validación transaccional estricta que impide doble reserva para cualquier profesional de salud.
        </p>
      </div>

      <div className="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
        <div className="w-10 h-10 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold">
          02
        </div>
        <h3 className="font-bold text-white text-base">Ficha Clínica y CIE-10</h3>
        <p className="text-xs text-slate-400 leading-relaxed">
          Registro transaccional de atención médica, anamnesis, signos vitales, diagnósticos estandarizados y recetas con trazabilidad inmutable.
        </p>
      </div>

      <div className="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
        <div className="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold">
          03
        </div>
        <h3 className="font-bold text-white text-base">Caja & Bonos Fonasa/Isapre</h3>
        <p className="text-xs text-slate-400 leading-relaxed">
          Validación obligatoria de folios de bonos, soporte para pagos con tarjeta, anulación no destructiva y conciliación de movimientos.
        </p>
      </div>
    </div>
  </div>
</Layout>
