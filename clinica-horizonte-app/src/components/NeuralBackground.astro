---
// Fondo interactivo animado de Red Neuronal / Conexiones Biomédicas
---

<canvas id="neural-canvas" class="fixed inset-0 pointer-events-none -z-10 w-full h-full"></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById('neural-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animationFrameId = null;

    // Accesibilidad: reducir velocidad si el sistema tiene reduccion de movimiento
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Coordenadas del cursor
    let mouse = { x: null, y: null, maxDist: 160 };

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = null;
      mouse.y = null;
    });

    // Paletas adaptativas según tema claro y modo oscuro teal
    function getPalette() {
      const isDark = typeof document !== 'undefined' && document.documentElement.classList.contains('dark');
      if (isDark) {
        return [
          'rgba(118, 238, 198, ', // Aquamarine acento brillante (#76eec6)
          'rgba(45, 212, 191, ',  // Teal-400 vibrante (#2dd4bf)
          'rgba(20, 184, 166, ',  // Teal-500 (#14b8a6)
          'rgba(94, 234, 212, ',  // Teal-300 luminoso (#5eead4)
        ];
      }
      return [
        'rgba(118, 238, 198, ',  // Aquamarine luminoso (#76eec6)
        'rgba(69, 139, 116, ',   // Aquamarine clínico profundo (#458b74)
        'rgba(92, 219, 177, ',   // Aquamarine intermedio (#5cdbb1)
        'rgba(194, 245, 229, ',  // Aquamarine suave pastel (#c2f5e5)
      ];
    }

    const particles = [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
      initParticles();
    }

    function initParticles() {
      particles.length = 0;
      const count = Math.floor((width * height) / (width < 768 ? 22000 : 16000));
      const clampedCount = Math.max(25, Math.min(count, 65));
      const activeColors = getPalette();

      for (let i = 0; i < clampedCount; i++) {
        const speed = prefersReducedMotion ? 0.08 : 0.35;
        const colorBase = activeColors[Math.floor(Math.random() * activeColors.length)];
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * speed,
          vy: (Math.random() - 0.5) * speed,
          radius: Math.random() * 1.4 + 1.2,
          colorBase: colorBase,
          pulse: Math.random() * Math.PI * 2,
          pulseSpeed: 0.02 + Math.random() * 0.02,
        });
      }
    }

    // Escuchar cambios de tema en vivo
    window.addEventListener('clinical:theme-change', () => {
      initParticles();
    });

    function draw() {
      ctx.clearRect(0, 0, width, height);

      const maxConnectDist = width < 768 ? 95 : 130;
      const maxConnectDistSq = maxConnectDist * maxConnectDist;
      const mouseMaxDistSq = mouse.maxDist * mouse.maxDist;

      const isDark = typeof document !== 'undefined' && document.documentElement.classList.contains('dark');

      // 1. Conexiones sinápticas entre nodos cercanos
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < maxConnectDistSq) {
            const dist = Math.sqrt(distSq);
            const alpha = (1 - dist / maxConnectDist) * (isDark ? 0.22 : 0.16);
            ctx.beginPath();
            ctx.strokeStyle = isDark ? `rgba(45, 212, 191, ${alpha})` : `rgba(118, 238, 198, ${alpha})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }

        // 2. Conexión suave hacia el cursor
        if (mouse.x !== null && mouse.y !== null) {
          const mdx = p1.x - mouse.x;
          const mdy = p1.y - mouse.y;
          const mDistSq = mdx * mdx + mdy * mdy;

          if (mDistSq < mouseMaxDistSq) {
            const mDist = Math.sqrt(mDistSq);
            const mAlpha = (1 - mDist / mouse.maxDist) * (isDark ? 0.45 : 0.32);
            ctx.beginPath();
            ctx.strokeStyle = isDark ? `rgba(118, 238, 198, ${mAlpha})` : `rgba(69, 139, 116, ${mAlpha})`;
            ctx.lineWidth = 1;
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();

            // Atracción sutil
            if (!prefersReducedMotion) {
              const force = (1 - mDist / mouse.maxDist) * 0.025;
              p1.x += mdx * force;
              p1.y += mdy * force;
            }
          }
        }
      }

      // 3. Dibujar nodos con pulso vital tenue
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        p.pulse += p.pulseSpeed;
        const currentAlpha = 0.35 + Math.sin(p.pulse) * 0.15;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `${p.colorBase}${currentAlpha})`;
        ctx.shadowColor = isDark ? 'rgba(45, 212, 191, 0.6)' : 'rgba(118, 238, 198, 0.4)';
        ctx.shadowBlur = isDark ? 6 : 4;
        ctx.fill();
        ctx.shadowBlur = 0;

        // Movimiento autónomo suave
        p.x += p.vx;
        p.y += p.vy;

        // Recorrido toroidal suave en bordes
        if (p.x < -10) p.x = width + 10;
        else if (p.x > width + 10) p.x = -10;

        if (p.y < -10) p.y = height + 10;
        else if (p.y > height + 10) p.y = -10;
      }

      animationFrameId = requestAnimationFrame(draw);
    }

    // Pausar si la pestaña no está visible (ahorro de batería y CPU)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
      } else {
        animationFrameId = requestAnimationFrame(draw);
      }
    });

    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(resize, 150);
    });

    resize();
    animationFrameId = requestAnimationFrame(draw);
  })();
</script>
